      <column caption="Orders" datatype="integer" default-format="n#,##0" name="[Calculation_5952055318720512]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD([order_id])"/>
      </column>
      <column caption="On-time %" datatype="real" default-format="p0.0%" name="[Calculation_5952055319207937]" role="measure" type="quantitative">
        <calculation class="tableau" formula="1 - AVG([late])"/>
      </column>
      <column caption="Late Deliveries" datatype="integer" default-format="n#,##0" name="[Calculation_5952055319445506]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([late])"/>
      </column>
      <column caption="Failed %" datatype="real" default-format="p0.0%" name="[Calculation_5952055319638019]" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([failed])"/>
      </column>
      <column caption="Avg Delivery Days" datatype="real" default-format="n0.0" name="[Calculation_5952055319830532]" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([delivery_days])"/>
      </column>
      <column caption="Seller late handover %" datatype="real" default-format="p0.0%" name="[Calculation_5952055322243077]" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([seller_late])"/>
      </column>
      <column caption="Avg Review" datatype="real" default-format="n0.00" name="[Calculation_5952055322439686]" role="measure" type="quantitative">
        <calculation class="tableau" formula="AVG([review_score])"/>
      </column>
      <column caption="Freight Share" datatype="real" default-format="p0.0%" name="[Calculation_5952055322578951]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([freight])/(SUM([item_value])+SUM([freight]))"/>
      </column>
      <column caption="Delivery" datatype="string" default-format="#,##0" name="[Calculation_5952055322877960]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [late] = 1 THEN &quot;Late&quot; ELSEIF [late] = 0 THEN &quot;On Time&quot; END"/>
