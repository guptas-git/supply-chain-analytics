            <column caption="Late Handover Rate" datatype="real" default-format="p0.0%" name="[Calculation_5952055323582473]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([late_handovers]) / SUM([items_shipped])"/>
            </column>
            <column caption="Items Shipped" datatype="integer" name="[items_shipped]" role="measure" type="quantitative" default-format="n#,##0"/>
            <column caption="Late Handovers" datatype="integer" name="[late_handovers]" role="measure" type="quantitative"/>
